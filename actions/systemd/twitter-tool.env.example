# 生成至少 32 字节的 ASCII 随机密钥，并只让服务调用方持有。
TW_SERVICE_TOKEN=replace-with-a-long-random-secret

# 精确写成 1 才会开启写动作；其余值均为关闭。
TW_ALLOW_WRITE=0

# 开写前必须填实际允许操作的小号 handle，可带或不带 @。
TW_EXPECTED_ACTOR=

# 可选：常驻 Chrome 的 CDP 地址。
TW_CDP_URL=http://127.0.0.1:9333

# 可选：feed/profile 列表页留给后续 read 真点击复用的秒数（最小 30）。
TW_BROWSE_TTL_SECONDS=180
